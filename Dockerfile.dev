FROM cgr.dev/chainguard/node:20-dev
WORKDIR /app

COPY package.json package-lock.json* ./
RUN npm ci

COPY tsconfig.json vite.config.ts tailwind.config.ts postcss.config.js* ./
# Source is volume-mounted in docker-compose.dev.yml for hot-reload.
# This COPY ensures the image works standalone (e.g. CI smoke tests).
COPY src ./src
COPY public ./public

EXPOSE 5173

# --host exposes the dev server outside the container (required in Docker)
CMD ["npm", "run", "dev", "--", "--host"]
